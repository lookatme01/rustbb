# PostgreSQL connection string
DATABASE_URL=postgres://rbb@127.0.0.1:5433/rbb
# Address to listen on
RBB_LISTEN=127.0.0.1:8080
# Long random secret (CSRF tokens, captcha, signed cookies). MUST be identical on all nodes.
# rbb refuses to start with this placeholder or anything under 32 characters: openssl rand -hex 32
RBB_SECRET=change-me-to-a-long-random-string
# Max database connections per node
RBB_DB_MAX_CONNECTIONS=32
# Where attachments and avatars are stored (share it between nodes, e.g. NFS/EFS)
RBB_UPLOAD_DIR=uploads
# Set to true behind a reverse proxy on this machine so client IPs come from X-Forwarded-For
RBB_TRUST_PROXY=false
# Proxies to believe when it runs elsewhere (another host or container), e.g. 10.0.0.0/8
# RBB_TRUSTED_PROXIES=10.0.0.0/8
# Where uploads live: local (the directory above) or s3 (credentials from AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY)
# RBB_STORAGE=s3
# RBB_S3_BUCKET=my-forum-uploads
# RBB_S3_ENDPOINT=https://s3.example.com   # only for non-AWS stores
# RBB_S3_REGION=us-east-1
# RBB_S3_PREFIX=rbb
# Biggest upload in MiB; keep nginx's client_max_body_size a little above it
# RBB_MAX_UPLOAD_MB=25
# Private port for /metrics, /livez and /readyz
# RBB_ADMIN_LISTEN=127.0.0.1:9090
# Seconds to keep serving after a shutdown signal (set it behind a load balancer)
# RBB_SHUTDOWN_DRAIN_SECS=5
# Set to true when served over HTTPS
RBB_SECURE_COOKIES=false
# Directory of Rhai plugins
RBB_PLUGINS_DIR=plugins
# Memory (MiB) for the guest page cache; 0 turns it off. Off automatically with RBB_DEV_TEMPLATES.
RBB_PAGE_CACHE_MB=64
# JSON logs for log shipping
RBB_LOG_JSON=false
# Log filter
RUST_LOG=rbb=info,tower_http=warn,sqlx=warn
# Development only: read templates from disk on every request
# RBB_DEV_TEMPLATES=templates
