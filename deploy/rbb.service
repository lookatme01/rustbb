# One unit per role on bigger boards: copy this file to rbb-worker.service and
# rbb-scheduler.service with ExecStart=/opt/rbb/rbb worker / scheduler.
[Unit]
Description=rbb forum server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=rbb
Group=rbb
WorkingDirectory=/opt/rbb
EnvironmentFile=/opt/rbb/.env
ExecStart=/opt/rbb/rbb serve
# Behind a load balancer, keep serving a few seconds after SIGTERM so it can notice this node
# is going away. Uncomment (and keep it below TimeoutStopSec) for that kind of setup.
#Environment=RBB_SHUTDOWN_DRAIN_SECS=5
# SIGTERM starts a graceful shutdown: readiness turns off, in-flight requests and background
# batches finish, buffers are flushed.
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=always
RestartSec=2
LimitNOFILE=65536
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# The dash tolerates a missing directory; create it with:
#   install -d -o rbb -g rbb /opt/rbb/uploads
ReadWritePaths=-/opt/rbb/uploads

[Install]
WantedBy=multi-user.target
